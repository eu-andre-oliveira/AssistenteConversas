@page "/analisar"
@rendermode InteractiveServer
@using AssistenteConversas.Models
@using AssistenteConversas.Services
@inject IConversationAnalyzer Analyzer
@inject ILeadService LeadService
@inject NavigationManager Navigation

<PageTitle>Analisar conversa | Assistente de Conversas</PageTitle>

<h1>Analisar conversa</h1>
<p class="text-secondary">Cole somente o texto copiado manualmente da conversa. Nada é enviado enquanto você digita.</p>

<div class="row g-4">
    <div class="col-lg-5">
        <label class="form-label" for="conversation">Conversa original</label>
        <textarea id="conversation" class="form-control" rows="14" @bind="conversation"
                  placeholder="Cole a conversa aqui..."></textarea>
        <div class="form-text">@conversation.Length caracteres</div>

        <label class="form-label mt-3" for="manualName">Nome informado manualmente (opcional)</label>
        <input id="manualName" class="form-control" @bind="manualName" />

        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" @onclick="Analyze" disabled="@isLoading">
                @(isLoading ? "Analisando..." : "Analisar conversa")
            </button>
            <button class="btn btn-outline-secondary" @onclick="Clear" disabled="@isLoading">Limpar</button>
        </div>
    </div>

    <div class="col-lg-7">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (result is not null)
        {
            <div class="alert alert-warning">Revise e corrija os dados antes de salvar o lead.</div>
            <button class="btn btn-success mb-3" @onclick="SaveLead">Salvar como lead</button>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Nome</label><input class="form-control" @bind="result.Nome" /></div>
                <div class="col-md-6"><label class="form-label">Empresa</label><input class="form-control" @bind="result.Empresa" /></div>
                <div class="col-md-6"><label class="form-label">Cargo</label><input class="form-control" @bind="result.Cargo" /></div>
                <div class="col-md-6"><label class="form-label">E-mail</label><input class="form-control" @bind="result.Email" /></div>
                <div class="col-md-6"><label class="form-label">Telefone</label><input class="form-control" @bind="result.Telefone" /></div>
                <div class="col-md-6"><label class="form-label">Perfil LinkedIn</label><input class="form-control" @bind="result.PerfilLinkedIn" /></div>
                <div class="col-12"><label class="form-label">Necessidade</label><textarea class="form-control" @bind="result.Necessidade"></textarea></div>
                <div class="col-md-6"><label class="form-label">Produto de interesse</label><input class="form-control" @bind="result.ProdutoInteresse" /></div>
                <div class="col-md-6"><label class="form-label">Nível de interesse</label><input class="form-control" @bind="result.NivelInteresse" /></div>
                <div class="col-md-6"><label class="form-label">Temperatura</label><select class="form-select" @bind="result.Temperatura"><option>Indefinido</option><option>Frio</option><option>Morno</option><option>Quente</option></select></div>
                <div class="col-md-6"><label class="form-label">Confiança</label><input class="form-control" value="@(result.Confianca?.ToString("0.##") ?? "Não identificado")" readonly /></div>
                <div class="col-12"><label class="form-label">Resumo</label><textarea class="form-control" @bind="result.Resumo"></textarea></div>
                <div class="col-12"><label class="form-label">Observações</label><textarea class="form-control" @bind="result.Observacoes"></textarea></div>
            </div>
        }
        else if (!isLoading)
        {
            <div class="border rounded p-4 text-secondary">O resultado da análise aparecerá aqui.</div>
        }
    </div>
</div>

@code {
    private string conversation = string.Empty;
    private string? manualName;
    private ConversationAnalysisResult? result;
    private string? errorMessage;
    private bool isLoading;

    private async Task SaveLead()
    {
        if (result is null) return;
        try
        {
            var lead = new Lead
            {
                Nome = result.Nome ?? string.Empty,
                Empresa = result.Empresa, Cargo = result.Cargo, Email = result.Email,
                Telefone = result.Telefone, PerfilLinkedIn = result.PerfilLinkedIn,
                Necessidade = result.Necessidade, ProdutoInteresse = result.ProdutoInteresse,
                NivelInteresse = result.NivelInteresse, Temperatura = result.Temperatura ?? LeadValues.TemperaturaIndefinido,
                PrazoEstimado = result.PrazoEstimado, ProximaAcao = result.ProximaAcao,
                Resumo = result.Resumo, Observacoes = result.Observacoes, ConversaOriginal = conversation
            };
            var saved = await LeadService.CreateAsync(lead);
            Navigation.NavigateTo($"/leads/{saved.Id}");
        }
        catch (ArgumentException ex) { errorMessage = ex.Message; }
        catch { errorMessage = "Não foi possível salvar o lead."; }
    }

    private async Task Analyze()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(conversation))
        {
            errorMessage = "Cole uma conversa antes de iniciar a análise.";
            return;
        }

        isLoading = true;
        try
        {
            result = await Analyzer.AnalyzeAsync(conversation);
            if (!string.IsNullOrWhiteSpace(manualName))
            {
                result.Nome = manualName.Trim();
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch
        {
            errorMessage = "Não foi possível analisar a conversa. Tente novamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Clear()
    {
        conversation = string.Empty;
        manualName = null;
        result = null;
        errorMessage = null;
    }
}
